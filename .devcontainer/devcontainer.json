{
  "name": "night-pr-reviewer",

  // Python 3.11 matches the version pinned in
  // .github/workflows/pr-review.yml so local + CI behave identically.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",

  "features": {
    // Next.js 16 + @types/node ^20 → Node 20 LTS.
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    // Used by the README's `gh workflow run` / PR triage commands.
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "containerEnv": {
    // Make Python output stream straight to the terminal (otherwise
    // pr_reviewer.py logs buffer in long-running shells).
    "PYTHONUNBUFFERED": "1",
    "PIP_DISABLE_PIP_VERSION_CHECK": "1"
  },

  // Install both stacks on container creation so the workspace is
  // ready-to-run after the first `devpod up`. `--no-audit --no-fund`
  // keeps the dashboard install quiet and fast.
  "postCreateCommand": "pip install --user -r agent/requirements.txt && cd dashboard && npm install --no-audit --no-fund",

  // Forward Next.js dev server. The agent + digest scripts are CLI-only.
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "dashboard (next dev)",
      "onAutoForward": "notify"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "github.vscode-github-actions"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "editor.formatOnSave": false,
        "[python]": {
          "editor.tabSize": 4
        },
        "[typescript]": {
          "editor.tabSize": 2
        },
        "[typescriptreact]": {
          "editor.tabSize": 2
        }
      }
    }
  },

  "remoteUser": "vscode"
}
