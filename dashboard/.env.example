# Copy to .env.local for local development. On Vercel, set each of these in
# the project's "Environment Variables" panel.

# --- Public Supabase (read-only dashboard pages + v2 SaaS auth) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- v2 SaaS auth (feat/saas-multi-tenant) -------------------------------
# Fully-qualified base URL of this dashboard. Used by app/login to build
# Supabase Auth `redirectTo` / `emailRedirectTo` values that GitHub OAuth
# and magic-link emails come back to. Falls back to window.location.origin
# in local dev when unset.
#
# Examples:
#   local:   http://localhost:3000
#   prod:    https://lyncas.vercel.app
#   preview: https://<preview-branch>-lyncas.vercel.app
NEXT_PUBLIC_SITE_URL=

# --- GitHub App (preferred repo connection method, migration 011) --------
# Create one App at https://github.com/settings/apps/new with:
#   - Permissions: contents:read, pull-requests:write, metadata:read
#   - Subscribe to events: pull_request
#   - Webhook URL: https://<your-deploy>/api/webhook/pull-request
#     (same webhook the agent already consumes)
#   - Setup URL (post-install redirect):
#     https://<your-deploy>/auth/github-app/callback
#     Tick "Redirect on update" so re-selecting repos re-hits the callback.
#
# After creation, fill these in:

# Numeric App ID shown on the App's settings page.
GITHUB_APP_ID=

# OAuth client credentials of the App (separate from the App ID — they
# appear on the same settings page once you click "Generate a new client
# secret"). Only used if you later flip on user-to-server auth; the
# installation-token path uses just APP_ID + PRIVATE_KEY, but we provision
# both env vars now so the App is fully wired.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Full contents of the App's private key (.pem file). Vercel env-var
# UIs strip newlines, so encode them as literal `\n` here — the server
# code does `.replace(/\\n/g, '\n')` before passing to jsonwebtoken.
# Example value (shortened):
#   -----BEGIN RSA PRIVATE KEY-----\nMIIEpAIB…\n…\n-----END RSA PRIVATE KEY-----\n
GITHUB_APP_PRIVATE_KEY=

# The App's slug — the last URL segment of github.com/apps/<slug>.
# Used to build the public install link from the connect-repo page:
#   https://github.com/apps/{GITHUB_APP_SLUG}/installations/new
# Public (NEXT_PUBLIC_) because the install button renders client-side.
NEXT_PUBLIC_GITHUB_APP_SLUG=

# --- Webhook → workflow_dispatch trigger (server-only) ---------------------
# Same random secret you paste into the GitHub webhook "Secret" field.
WEBHOOK_SECRET=

# Fine-grained PAT with `actions: write` on the agent repo (the repo that
# hosts pr-review.yml). The webhook uses this to call the GitHub Actions
# workflow_dispatch API and immediately trigger a review run.
#
# This is INTENTIONALLY a different env var than the agent-side
# PR_REVIEWER_PAT (which the Python script uses to read diffs / post
# comments on the target repos). The two PATs may be owned by different
# GitHub accounts when the agent repo and the target repos are owned by
# different accounts — a fine-grained PAT can only access repos owned by
# the account that created it.
AGENT_WORKFLOW_PAT=

# `<owner>/<repo>` of the agent repo whose pr-review.yml workflow we
# dispatch — NOT the repo a PR was opened against. The same workflow handles
# all configured REPOS, so this is one constant per Vercel deploy.
AGENT_REPO=

# Optional overrides. Defaults below.
# AGENT_WORKFLOW=pr-review.yml
# AGENT_WORKFLOW_REF=main

# --- /dashboard/chat (AI repo assistant) ----------------------------------
# The chat page pre-fetches GitHub data (open PRs, branches, commits,
# collaborators, PR diffs) and asks Claude to answer questions about
# the repo. Two env vars drive it:

# Anthropic API key. Uses claude-sonnet-4-5 (NOT Opus) for cost reasons.
# Get one at https://console.anthropic.com/. If unset, /api/chat returns
# HTTP 503 with a clear error message rather than crashing.
ANTHROPIC_API_KEY=

# GitHub PAT used server-side by /api/chat as the LAST-RESORT credential
# for a repo (e.g. when a watched_repos row has neither a PAT nor an
# installation_id). Multi-tenant deploys normally rely on per-user
# tokens; this is the public-read / single-tenant fallback.
PR_REVIEWER_PAT=

# --- /dashboard/settings OTP email (digest verification) -----------------
# When a user confirms their digest email address we send a 6-digit OTP
# to that address. If either of these is unset the OTP is logged to the
# server console and returned in the API response so dev/preview deploys
# still work end-to-end (the user can copy from the response).
#
# To enable Gmail SMTP:
#   1. Create a Gmail App Password at https://myaccount.google.com/apppasswords
#      (requires 2FA on the Google account).
#   2. Set GMAIL_USER to the sender address and GMAIL_APP_PASSWORD to
#      the 16-char app password (NOT your real password).
#
# These are the same env-var names agent/send_digest.py already uses, so
# a single Gmail account can serve both the digest sender and the OTP
# sender.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- DevPod MCP connect layer (migration 014) ----------------------------
# Shared secret the devpod-connect CLI authenticates with against
# /api/devpod/register and /api/devpod/ping. The dashboard's
# /api/devpod/token route returns the user's connect token in the form
# `<github_username>:<DEVPOD_CONNECT_SECRET>`; the CLI sends that
# composite string back as `secret` on every call, and the route
# verifies the username half matches the body's `github_username`.
#
# Generate with: openssl rand -hex 32
#
# Caveat: this is a single deploy-wide secret. A user can split their
# own connect token to recover the bare secret and forge a token for
# any other username on the same deploy. Acceptable for single-org
# deployments; per-user rotation is on the v2 hardening list.
DEVPOD_CONNECT_SECRET=
