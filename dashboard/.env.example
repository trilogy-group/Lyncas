# Copy to .env.local for local development. On Vercel, set each of these in
# the project's "Environment Variables" panel.

# --- Public Supabase (read-only dashboard pages) ---------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Webhook route (server-only — never expose with NEXT_PUBLIC_) ----------
# Random secret you also paste into the GitHub webhook "Secret" field.
WEBHOOK_SECRET=

# Anthropic key for the review + fingerprint summarizer calls.
ANTHROPIC_API_KEY=

# Fine-grained PAT with `contents: read` + `pull_requests: write` on each
# target repo. Same value the GitHub Actions cron uses (PR_REVIEWER_PAT).
PR_REVIEWER_PAT=

# Supabase URL + service-role key for `reviews` / `repo_fingerprints` writes.
# SUPABASE_URL falls back to NEXT_PUBLIC_SUPABASE_URL if unset.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional: enable the three-gate auto-close from the webhook path. Mirrors
# the cron's ALLOW_AUTO_CLOSE flag. Defaults to false.
ALLOW_AUTO_CLOSE=false
