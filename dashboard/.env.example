# Copy to .env.local for local dev and fill in the values from Supabase
# project settings -> API.
#
# These are the *public* anon credentials — safe to expose in client bundles.
# The agent uses the service_role key (SUPABASE_SERVICE_KEY) which lives only
# in GitHub Actions secrets and is never read by this dashboard.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
